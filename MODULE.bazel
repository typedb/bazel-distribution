module(
    name = "typedb_bazel_distribution",
    compatibility_level = 1,
    version = "0.0.0",
)

# ===========================================================
# Common
# ===========================================================

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# ===========================================================
# Build dependencies
# ===========================================================

bazel_dep(name = "toolchains_llvm", dev_dependency = True, version = "1.3.0")
llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)
llvm.toolchain(name = "llvm_toolchain", llvm_version = "18.1.8")
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@org_chromium_sysroot_linux_arm64//:sysroot",
    targets = ["linux-aarch64"],
)
use_repo(llvm, "llvm_toolchain")

http_archive(
    name = "org_chromium_sysroot_linux_arm64",
    build_file_content = """
filegroup(
    name = "sysroot",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "2e3a344f48da76b6532f3de86759f94359292143ccaf6094814e09441a36629f",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/toolchain/0e28d9832614729bb5b731161ff96cb4d516f345/debian_bullseye_arm64_sysroot.tar.xz"],
)

register_toolchains("@llvm_toolchain//:all", dev_dependency = True)

# ===========================================================
# Languages & toolchains
# ===========================================================

# Rust
bazel_dep(name = "rules_rust", version = "0.56.0")

# Kotlin
bazel_dep(name = "rules_kotlin", repo_name = "io_bazel_rules_kotlin", version = "2.0.0")
register_toolchains("@io_bazel_rules_kotlin//kotlin/internal:default_toolchain")

# Python
bazel_dep(name = "rules_python", version = "1.0.0")
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(is_default = True, python_version = "3.11")

# C/C++
bazel_dep(name = "rules_cc", version = "0.0.17")

# .NET (used by //nuget:rules.bzl)
bazel_dep(name = "rules_dotnet", version = "0.14.0")

# Node.js
bazel_dep(name = "rules_nodejs", version = "6.3.2")
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(name = "nodejs", node_version = "17.9.1",)
use_repo(node, "nodejs")

# ===========================================================
# Platform definitions
# ===========================================================

bazel_dep(name = "platforms", version = "0.0.10")

# ===========================================================
# Package managers
# ===========================================================

# Pip
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip_tdb",
    python_version = "3.11",
    requirements_lock = "//:pip/requirements.txt",
)
pip.parse(
    hub_name = "pip_uploader",
    python_version = "3.11",
    requirements_lock = "//:common/uploader/requirements.txt",
)
use_repo(
    pip,
    "pip_tdb",
    "pip_uploader",
)

# Maven
bazel_dep(name = "rules_jvm_external", version = "6.6")
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "bazel_distribution_maven",
    artifacts = [
        "com.eclipsesource.minimal-json:minimal-json:0.9.5",
        "com.electronwill.night-config:core:3.6.5",
        "com.electronwill.night-config:toml:3.6.5",
        "com.google.http-client:google-http-client:1.34.2",
        "info.picocli:picocli:4.3.2",
        "org.apache.commons:commons-compress:1.21",
        "org.jsoup:jsoup:1.16.1",
        "org.zeroturnaround:zt-exec:1.10",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
    strict_visibility = True,
)
use_repo(maven, "bazel_distribution_maven")

# ===========================================================
# Assembly & deployments
# ===========================================================

bazel_dep(name = "rules_pkg", version = "1.0.1")
http_archive(
    name = "ghr_osx_zip",
    build_file_content = 'exports_files(["ghr"])',
    sha256 = "b5d1379e519fc3b795f3b81e5404d427e0abd8837d9e249f483a72f999dd4f47",
    strip_prefix = "ghr_v0.12.1_darwin_amd64",
    urls = ["https://github.com/tcnksm/ghr/releases/download/v0.12.1/ghr_v0.12.1_darwin_amd64.zip"],
)
http_archive(
    name = "ghr_linux_tar",
    build_file_content = 'exports_files(["ghr"])',
    sha256 = "471c2eb1aee20dedffd00254f6c445abb5eb7d479bcae32c4210fdcf036b2dce",
    strip_prefix = "ghr_v0.12.1_linux_amd64",
    urls = ["https://github.com/tcnksm/ghr/releases/download/v0.12.1/ghr_v0.12.1_linux_amd64.tar.gz"],
)

# ===========================================================
# Docs
# ===========================================================

bazel_dep(name = "stardoc", repo_name = "bazel_stardoc", version = "0.7.2")
docs_pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
docs_pip.parse(
    hub_name = "typedb_bazel_distribution_docs_py",
    python_version = "3.11",
    requirements_lock = "//:docs/python/requirements.txt",
)
use_repo(docs_pip, "typedb_bazel_distribution_docs_py")
